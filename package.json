{
  "name": "flog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "preview": "vite preview",
    "deploy:dev": "npm run build:dev && firebase use dev && firebase deploy --only hosting,firestore:rules",
    "deploy:prod": "npm run build:prod && firebase use prod && firebase deploy --only hosting,firestore:rules",
    "deploy:hosting:dev": "npm run build:dev && firebase use dev && firebase deploy --only hosting",
    "deploy:hosting:prod": "npm run build:prod && firebase use prod && firebase deploy --only hosting",
    "deploy:rules:dev": "firebase use dev && firebase deploy --only firestore:rules",
    "deploy:rules:prod": "firebase use prod && firebase deploy --only firestore:rules",
    "emulators": "firebase emulators:start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#.firebase\" \"#dispatch/M1-g-outputs.md\"",
    "test": "TZ=America/New_York vitest run",
    "test:rules": "firebase --project=flog-rules-test emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "import:history": "node scripts/import-history.mjs"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.10.0",
    "globals": "^17.6.0",
    "markdownlint-cli2": "^0.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  }
}
