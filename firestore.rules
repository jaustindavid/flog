rules_version = '2';

// flog Firestore rules — translation of PRD §6 access control matrix.
// ADMIN_EMAIL is hardcoded (bootstrap-admin carve-out per PRD §5.4
// + §6 helper). Same literal in dev and prod deployments.
//
// Two layers of enforcement:
//   1. AUTHORIZATION — who may touch a doc (ownerUid / sharee /
//      allowlist / admin). Original M2–M5 logic, unchanged.
//   2. VALIDATION — what shape a write may have. Added 2026-05-29
//      (security review P1): every create/update pins its field SET
//      (hasOnly), TYPES, numeric RANGES, and server-set timestamps
//      (createdAt/loggedAt == request.time). Without this, any
//      allowlisted client using the raw SDK could write garbage,
//      extra fields, a forged loggedAt (which reorders entries and
//      silently corrupts every reader's MPG/stat numbers), or a
//      forged createdAt. The numeric upper bounds are deliberately
//      generous — their job is to reject NaN/Infinity/absurd values,
//      not to enforce data quality (the client validators do that).

service cloud.firestore {
  match /databases/{database}/documents {

    function allowed(email) {
      return email == 'austindavid@gmail.com'
          || exists(/databases/$(database)/documents/allowlist/$(email));
    }

    // PRD §6.1 — User
    match /users/{userId} {
      allow read: if request.auth != null
                     && request.auth.uid == userId;

      // create: allowlisted self only; field set pinned, uid bound to
      // the doc id, createdAt server-set. email is typed but NOT
      // pinned to token.email — the client stores canonicalEmail()
      // (lowercased) which a token's email claim may differ from by
      // case, and rules can't lowercase; pinning it would risk
      // breaking first sign-in (see security review P3).
      allow create: if request.auth != null
                       && request.auth.uid == userId
                       && allowed(request.auth.token.email)
                       && request.resource.data.keys()
                            .hasOnly(['uid', 'email', 'displayName', 'createdAt'])
                       && request.resource.data.uid == userId
                       && request.resource.data.email is string
                       && request.resource.data.displayName is string
                       && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
                       && request.auth.uid == userId
                       && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['displayName'])
                       && request.resource.data.displayName is string;

      allow delete: if false;
    }

    // PRD §6.2 — Car
    match /cars/{carId} {
      // Shared subcollection authz helpers (maintenance-phase-1 §7.4):
      // lifted UP from inside the entries block to car scope so BOTH
      // the entries and maintenance subcollections share them. These
      // are car-level concepts; behavior is identical to the prior
      // entries-block definitions. `request`/`resource` resolve at the
      // CALL SITE — i.e. the subcollection doc being read/mutated — so
      // canMutate()'s resource.data.loggedByUid refers to the entry or
      // maintenance doc, not the car (both subcollections carry a
      // loggedByUid field). The car-level rules below do NOT call these.
      function parentCar() {
        return get(/databases/$(database)/documents/cars/$(carId)).data;
      }
      function canReadParent() {
        return request.auth != null && (
          parentCar().ownerUid == request.auth.uid
          || request.auth.token.email in parentCar().shareeEmails
        );
      }
      // Owner of the parent car may edit/delete ANY doc on it. The
      // original logger may edit/delete their OWN doc, but only while
      // they still have read access to the car — canReadParent() closes
      // the unshared-former-sharee hole.
      //
      // Null-safety (edit-delete-entries dispatch 2026-05-29): the owner
      // branch parentCar().ownerUid == request.auth.uid is safe on an
      // unauthenticated request because request.auth.uid is then null and
      // parentCar().ownerUid == null is false — the unauth caller falls
      // through to the logger branch, where canReadParent()'s own
      // request.auth != null check denies. The owner branch's safety does
      // NOT come from canReadParent(); that helper only guards the logger
      // branch.
      function canMutate() {
        return parentCar().ownerUid == request.auth.uid
            || (canReadParent()
                && resource.data.loggedByUid == request.auth.uid);
      }

      // Field/shape validation for a Car create. Authorization
      // (allowlisted + ownerUid == self) is checked separately below.
      function validCarCreate(data) {
        return data.keys()
                 .hasOnly(['name', 'ownerUid', 'shareeEmails', 'createdAt'])
            && data.name is string
            && data.ownerUid is string
            && data.shareeEmails is list
            && data.createdAt == request.time;
      }

      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || request.auth.token.email in resource.data.shareeEmails
      );

      allow create: if request.auth != null
                       && allowed(request.auth.token.email)
                       && request.resource.data.ownerUid == request.auth.uid
                       && validCarCreate(request.resource.data);

      // update: owner only; only name + shareeEmails +
      // maintenanceReminder may change (hasOnly on the diff's
      // affectedKeys makes ownerUid AND createdAt immutable automatically
      // — they're not in the allowed set). Types re-checked on the
      // resulting doc so a rename/share can't write garbage.
      //
      // maintenanceReminder (Phase 3, PRD §14.3): absent on a rename/
      // share write (the !in branch no-ops — existing tests stay green),
      // null when clearing, or a map. SF4/B1 — intervals are validated
      // `is number` + range, NEVER `is int`: the JS SDK may encode a
      // whole number (e.g. intervalMiles: 3000) as a double, so `is int`
      // would reject a valid write at runtime (the same convention as
      // validMaintNumbers / validEntryNumbers). S1 — at least one
      // interval must be non-null (the final clause), mirroring the
      // file's pin-the-shape posture.
      allow update: if request.auth != null
                       && resource.data.ownerUid == request.auth.uid
                       && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['name', 'shareeEmails',
                                      'maintenanceReminder'])
                       && request.resource.data.name is string
                       && request.resource.data.shareeEmails is list
                       && (
                            !('maintenanceReminder' in request.resource.data)
                         || request.resource.data.maintenanceReminder == null
                         || (
                              request.resource.data.maintenanceReminder.keys()
                                .hasOnly(['label', 'intervalMiles',
                                          'intervalMonths'])
                           && request.resource.data.maintenanceReminder.label is string
                           && (request.resource.data.maintenanceReminder.intervalMiles == null
                               || (request.resource.data.maintenanceReminder.intervalMiles is number
                                   && request.resource.data.maintenanceReminder.intervalMiles > 0
                                   && request.resource.data.maintenanceReminder.intervalMiles < 100000000))
                           && (request.resource.data.maintenanceReminder.intervalMonths == null
                               || (request.resource.data.maintenanceReminder.intervalMonths is number
                                   && request.resource.data.maintenanceReminder.intervalMonths > 0
                                   && request.resource.data.maintenanceReminder.intervalMonths < 1200))
                           && (request.resource.data.maintenanceReminder.intervalMiles != null
                               || request.resource.data.maintenanceReminder.intervalMonths != null)
                         )
                       );

      allow delete: if request.auth != null
                       && resource.data.ownerUid == request.auth.uid;

      // PRD §6.3 — Entry. Authz helpers parentCar() / canReadParent() /
      // canMutate() are now defined at car scope above (lifted in
      // maintenance-phase-1 §7.4 so maintenance shares them); behavior
      // here is unchanged.
      match /entries/{entryId} {
        // Numeric shape for an entry's three editable fields. Validates
        // the RESULTING doc (request.resource.data), so it covers both
        // create and a partial update (the unchanged fields carry their
        // prior, already-valid values). Bounds reject strings, objects,
        // null, negatives, NaN, and Infinity (NaN/Infinity fail the
        // range comparisons) while never rejecting a real fill.
        function validEntryNumbers(data) {
          return data.odometer is number
              && data.odometer >= 0 && data.odometer < 100000000
              && data.gallons is number
              && data.gallons > 0 && data.gallons < 100000
              && data.cost is number
              && data.cost >= 0 && data.cost < 100000000;
        }

        allow read: if canReadParent();

        // create: car-reader logging as self; field set pinned,
        // loggedAt server-set, numerics validated. The hasOnly + the
        // loggedAt == request.time check together stop a forged
        // client-clock timestamp (the entry order, and thus everyone's
        // computed MPG, depends on loggedAt).
        allow create: if canReadParent()
                         && request.resource.data.keys().hasOnly(
                              ['loggedByUid', 'odometer', 'gallons',
                               'cost', 'loggedAt'])
                         && request.resource.data.loggedByUid == request.auth.uid
                         && request.resource.data.loggedAt == request.time
                         && validEntryNumbers(request.resource.data);

        // edit-delete-entries dispatch 2026-05-29: relaxed from
        // `if false`. odometer/gallons/cost editable; the hasOnly
        // guard makes loggedByUid and loggedAt immutable on update
        // (same field-restriction idiom M2 used for User displayName).
        // P1 (2026-05-29): + validEntryNumbers on the resulting doc.
        allow update: if canMutate()
                         && request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['odometer', 'gallons', 'cost'])
                         && validEntryNumbers(request.resource.data);

        // edit-delete-entries dispatch 2026-05-29: extended from
        // M4's owner-only (cascade) rule to owner-or-current-read-
        // access-logger. The owner branch still satisfies the M4
        // cascade in src/cars/cars.ts deleteCar.
        allow delete: if canMutate();
      }

      // PRD §14.1/§14.2 — Maintenance (maintenance-phase-1). A SEPARATE
      // subcollection from entries: the fuel/MPG pipeline stays pure.
      // Authz reuses the lifted parentCar()/canReadParent()/canMutate()
      // helpers (maintenance also carries loggedByUid). Field validation
      // mirrors the entries P1 idiom — with two deliberate differences:
      //   - `date` is the user-set SERVICE date: typed `is timestamp`
      //     but NOT pinned to request.time (backdating is the point).
      //   - `resetsReminder` (Phase 3) is a bool, in the create field
      //     set and the update editable set so a future checkbox needs
      //     no rules change; Phase 1's modal never writes it.
      // `loggedAt` stays the server-set audit timestamp (== request.time
      // on create; immutable on update via hasOnly).
      match /maintenance/{maintId} {
        // SF4 — `is number` (not `is int`), DELIBERATELY mirroring the
        // entries idiom: dodges the int-vs-double SDK-encoding trap; the
        // client (validateOdometer) enforces integer-ness for UX.
        function validMaintNumbers(data) {
          return data.odometer is number
              && data.odometer >= 0 && data.odometer < 100000000
              && data.cost is number
              && data.cost >= 0 && data.cost < 100000000;
        }

        allow read: if canReadParent();

        // create: car-reader logging as self; field set pinned, numerics
        // validated, note non-empty, resetsReminder a bool, loggedAt
        // server-set. `date` is any timestamp (backdatable) — NOT
        // request.time.
        allow create: if canReadParent()
                         && request.resource.data.keys().hasOnly(
                              ['loggedByUid', 'date', 'odometer', 'cost',
                               'note', 'resetsReminder', 'loggedAt'])
                         && request.resource.data.loggedByUid == request.auth.uid
                         && request.resource.data.date is timestamp
                         && request.resource.data.note is string
                         && request.resource.data.note.size() > 0
                         && request.resource.data.resetsReminder is bool
                         && request.resource.data.loggedAt == request.time
                         && validMaintNumbers(request.resource.data);

        // update: editable set is date/odometer/cost/note/resetsReminder
        // (resetsReminder included for Phase 3's checkbox — Phase 1 never
        // sends it). hasOnly makes loggedByUid + loggedAt immutable.
        // SF1: re-validate resetsReminder is bool on the resulting doc.
        allow update: if canMutate()
                         && request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['date', 'odometer', 'cost', 'note',
                                        'resetsReminder'])
                         && request.resource.data.date is timestamp
                         && request.resource.data.note is string
                         && request.resource.data.note.size() > 0
                         && request.resource.data.resetsReminder is bool
                         && validMaintNumbers(request.resource.data);

        allow delete: if canMutate();
      }
    }

    // Allowlist — derived from PRD §6.4 with one M3-time amendment:
    // read is broadened from "self only" to "any allowlisted user"
    // (see M3 V2 fix-forward 2026-05-28). Reason: shareCar's read-
    // then-conditional-batch pattern (M3 brief Decision #16) needs
    // to pre-read another email's allowlist doc to decide whether
    // the batch includes a set. With self-only read, that pre-read
    // denies and the whole share flow fails. Privacy cost at family
    // scale is negligible — allowlist docs are empty {} and the
    // exposure is just "is this email in the set." PRD §6.4 needs
    // a corresponding amendment.
    match /allowlist/{userEmail} {
      allow read: if request.auth != null
                     && allowed(request.auth.token.email);

      // The *requesting* user must be allowlisted to add a new email
      // (e.g., share-with-user side effect in M3). See dispatch
      // M2-auth-allowlist.md §7.3 — do NOT write allowed(userEmail).
      // The doc body is always an empty map {}; pin that shape.
      allow create: if request.auth != null
                       && allowed(request.auth.token.email)
                       && request.resource.data.keys().size() == 0;

      allow update: if false;

      allow delete: if request.auth != null
                       && request.auth.token.email == 'austindavid@gmail.com';
    }
  }
}
